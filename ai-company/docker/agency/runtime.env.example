# Template only. Create the real file outside the checkout, e.g. /etc/agency/runtime.env.
AGENCY_IMAGE=agency-app:replace-with-commit
APP_URL=https://agency.example.com
AGENCY_HTTP_PORT=3000
# Generate each independently with openssl rand -hex 32. Keep PostgreSQL password URL-safe.
POSTGRES_PASSWORD=
JWT_SECRET=
AUTH_SECRET=
TENANT_DATA_ENCRYPTION_FALLBACK_KEY=
# First-time native init also creates derived admin/employee accounts. Set their
# independent private passwords explicitly; remove these values after bootstrap.
OM_INIT_SUPERADMIN_EMAIL=
OM_INIT_SUPERADMIN_PASSWORD=
OM_INIT_ADMIN_PASSWORD=
OM_INIT_EMPLOYEE_PASSWORD=
# Optional extra trusted origins, not a wildcard.
APP_ALLOWED_ORIGINS=
# Central native provider configuration. A key does not approve spend.
OM_AI_PROVIDER=openrouter
OM_AI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Keep off until scoped workflows/budgets and paid execution are approved.
OM_AGENCY_TRIAGE_MODE=disabled
AGENCY_ANALYSIS_EXECUTION_ENABLED=false
