# Template only. Create the real file outside the checkout, e.g. /etc/agency/runtime.env.
AGENCY_IMAGE=agency-app:replace-with-commit
APP_URL=https://agency.example.com
AGENCY_HTTP_PORT=3000
# Generate each independently with openssl rand -hex 32. Keep PostgreSQL password URL-safe.
POSTGRES_PASSWORD=
JWT_SECRET=
AUTH_SECRET=
TENANT_DATA_ENCRYPTION_FALLBACK_KEY=
# First-time native init also creates derived admin/employee accounts. Set their
# independent private passwords explicitly; remove these values after bootstrap.
OM_INIT_SUPERADMIN_EMAIL=
OM_INIT_SUPERADMIN_PASSWORD=
OM_INIT_ADMIN_PASSWORD=
OM_INIT_EMPLOYEE_PASSWORD=
# Optional extra trusted origins, not a wildcard.
APP_ALLOWED_ORIGINS=
# Central native provider configuration. A key does not approve spend.
OM_AI_PROVIDER=openrouter
OM_AI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Keep off until scoped workflows/budgets and paid execution are approved.
# MODE is authoritative; legacy ENABLED alone never selects live execution.
OM_AGENCY_TRIAGE_ENABLED=false
OM_AGENCY_TRIAGE_MODE=disabled
AGENCY_ANALYSIS_EXECUTION_ENABLED=false
AGENCY_TOV_EXECUTION_ENABLED=false
# Staff-selected scout targets -> teammate scraper -> existing ToV intake.
# Default off; also requires ToV activation, scoped staff grants and workflow setup.
# Enable only after external collection/model spend is separately approved.
AGENCY_TOV_DISCOVERY_COLLECTION_ENABLED=false
APIFY_TOKEN=
# Explicit native live-triage bounds (milliseconds; retry count excludes first attempt).
# These are NOT a provider-enforced monetary ceiling or cancellation guarantee.
OM_AGENT_RUN_TIMEOUT_MS=60000
OM_AGENT_PROVIDER_RETRY_MAX=1
OM_AGENT_PROVIDER_RETRY_BASE_MS=1000
# Approved live opt-in: MODE=live, ANALYSIS/TOV flags=true as required, set the
# central model to openrouter/<exact-model-id> and key above, configure native
# scoped workflows/approved per-phase budgets, then redeploy the app.
# Never enable test fixtures, demo payments or publishing on this server profile.
# Runtime config cannot add features absent from the selected immutable image.

# Native Resend system mail; configure BEFORE first init to seed its scoped
# communication channel. Use a verified sender/domain and a private provider key.
# Registration verification cannot work until real delivery is configured/enabled.
OM_DISABLE_EMAIL_DELIVERY=true
SYSTEM_EMAIL_PROVIDER=resend
RESEND_API_KEY=
NOTIFICATIONS_EMAIL_FROM=
# Optional native sender fallbacks, in this order:
EMAIL_FROM=
ADMIN_EMAIL=
# Set OM_DISABLE_EMAIL_DELIVERY=false only when mail delivery is intended.
# Existing scopes: configure the native Resend integration + system-email channel
# in the staff UI; changing env does not rewrite already saved channel credentials.
